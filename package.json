{
  "name": "vrm-desktop-mate",
  "productName": "VRM Desktop Mate",
  "version": "0.1.13",
  "description": "\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u3092\u6b69\u304d\u56de\u308a\u3001\u30ab\u30e1\u30e9\u3067\u6349\u3048\u305f\u30e6\u30fc\u30b6\u30fc\u306e\u9854\u30fb\u8996\u7dda\u306e\u65b9\u5411\u3092\u5411\u304fVRM\u30de\u30b9\u30b3\u30c3\u30c8",
  "main": "src/main.js",
  "scripts": {
    "build:renderer": "esbuild src/renderer/app.js --bundle --format=esm --target=chrome130 --outfile=src/renderer/bundle.js --log-level=warning",
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron . --mate-debug",
    "dist": "npm run build:renderer && electron-builder --mac",
    "dist:dir": "npm run build:renderer && electron-builder --mac --dir",
    "install:app": "npm run dist:dir && rm -rf '/Applications/VRM Desktop Mate.app' && mv 'dist/mac-arm64/VRM Desktop Mate.app' /Applications/",
    "build:web": "bash tools/build-web.sh",
    "check": "node --check src/main.js && node --check src/preload.js && npm run build:renderer"
  },
  "license": "MIT",
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.0",
    "@pixiv/three-vrm-animation": "^3.5.5"
  },
  "devDependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "three": "^0.186.1"
  },
  "build": {
    "appId": "dev.vrm-desktop-mate.app",
    "productName": "VRM Desktop Mate",
    "files": [
      "src/main.js",
      "src/preload.js",
      "src/preload-handle.js",
      "src/renderer/handle.html",
      "src/motions.json",
      "src/renderer/index.html",
      "src/renderer/bundle.js",
      "assets/**/*",
      "node_modules/@mediapipe/tasks-vision/wasm/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "identity": null,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "\u3042\u306a\u305f\u306e\u9854\u306e\u5411\u304d\u3068\u8996\u7dda\u3092\u63a8\u5b9a\u3057\u3066\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u3042\u306a\u305f\u306e\u65b9\u3092\u5411\u304f\u305f\u3081\u306b\u4f7f\u3044\u307e\u3059\u3002\u6620\u50cf\u306f\u7aef\u672b\u5185\u3067\u306e\u307f\u51e6\u7406\u3055\u308c\u3001\u4fdd\u5b58\u30fb\u9001\u4fe1\u3055\u308c\u307e\u305b\u3093\u3002",
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64",
            "armv7l"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64",
            "armv7l"
          ]
        }
      ],
      "category": "Utility"
    },
    "asar": false
  }
}
